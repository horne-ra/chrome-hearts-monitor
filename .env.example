# ===== notification backend =====
NOTIFY_METHOD=discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY
# Separate private destination for product-monitor errors, recovery, and startup notices.
# No fallback to the product-drop webhook if this is missing or fails.
# DISCORD_MONITOR_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# ===== monitor tuning (all optional; defaults shown) =====
# CH_POLL_SECONDS=30          # target seconds between sweep starts
# CH_MAX_INDIVIDUAL=8         # items per Discord message in a large batch
# CH_STARTUP_PING=1           # private notice after a successful first sweep

# ===== persistent state =====
# On Railway, attach a Volume mounted at /data and set:
# CH_STATE_FILE=/data/seen_products.json
# CH_HEALTH_FILE=/data/seen_products.health.json  # derived from CH_STATE_FILE by default
# CH_HEALTH_FAILURE_THRESHOLD=3  # first warning after this many consecutive failed sweeps
# CH_HEALTH_REMINDER_SECONDS=21600 # private outage reminder every 6h; 0 disables reminders
# CH_BACKOFF_MAX_SECONDS=300     # max exponential delay; Retry-After may extend to 1h
# Locally you can leave this unset (defaults to ./seen_products.json).

# ----- alternate backends (only if NOTIFY_METHOD changed) -----
# Twilio:    TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM / TWILIO_TO
# email_sms: SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMS_TO

# ===== appointment-slot monitor (ww_slots_monitor.py) =====
# WW_LOCATION=chromehearts            # Waitwhile shortname (NY West Village)
# WW_STATE_FILE=/data/ww_slots.json   # volume path on Railway
# WW_POLL_SECONDS=20
# WW_DAYS_AHEAD=21
# WW_SERVICE_FILTER=                  # e.g. "in-store" to only alert on
#                                     #   In-store shopping capacity
# WW_STARTUP_PING=1

# ===== Miami slot monitor (same script as NYC, different location) =====
# WW_LOCATION=chromeheartsmiami
# WW_BOOK_URL=https://waitwhile.com/locations/chromeheartsmiami/services?registration=booking
# WW_STATE_FILE=/data/ww_slots_miami.json

# ===== Los Angeles slot monitor (Appointedd) =====
# APPT_SERVICES=LA In-store=5f649cb02f6894080a6a49e4
#   add Malibu: ",Malibu In-store=611d5b11f59673555d177f22"
# APPT_STATE_FILE=/data/appt_slots.json
# APPT_POLL_SECONDS=30
# APPT_DAYS_AHEAD=45
# APPT_ACCESS_TOKEN=            # optional override; normally auto-extracted
# APPT_STARTUP_PING=1
